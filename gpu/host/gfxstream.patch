+// HyperWin: the AHardwareBuffer behind a ColorBuffer resource, with a reference of its own the
+// caller releases (AHardwareBuffer_release), or null when the resource has none to give: not a
+// ColorBuffer, not on Android, or a Vulkan driver without VK_ANDROID_external_memory_android_
+// hardware_buffer, where ColorBuffer memory cannot be exported.
+VG_EXPORT void* stream_renderer_resource_get_ahb(uint32_t res_handle) {
+#if defined(__ANDROID__)
+    auto blob = FrameBuffer::getFB()->exportColorBuffer(res_handle);
+    if (!blob || blob->descriptorInfo.streamHandleType != STREAM_HANDLE_TYPE_PLATFORM_AHB) return nullptr;
+    auto* ahb = reinterpret_cast<AHardwareBuffer*>(blob->descriptorInfo.handle);
+    if (ahb) AHardwareBuffer_acquire(ahb);
+    return ahb;
+#else
+    (void)res_handle;
+    return nullptr;
+#endif
+}
