+static bool
+bo_in_list(const struct pan_kmod_bo *bo, struct pan_kmod_bo *const *list,
+           unsigned count)
+{
+   for (unsigned i = 0; i < count; i++) {
+      if (list[i] == bo)
+         return true;
+   }
+   return false;
+}
+
+int
+kbase_kmod_dmabuf_export_wait_fence(struct pan_kmod_dev *dev,
+                                    struct pan_kmod_bo *const *written_bos,
+                                    unsigned nr_written, bool write_all)
+{
+   struct kbase_kmod_dev *kdev = to_kbase_dev(dev);
+   int merged = -1;
+
+   mtx_lock(&kdev->dmabuf_lock);
+   list_for_each_entry(struct kbase_kmod_bo, kbo, &kdev->dmabuf_list,
+                       dmabuf_node) {
+      if (kbo->dmabuf_fd < 0)
+         continue;
+
+      bool writing = write_all || bo_in_list(&kbo->base, written_bos, nr_written);
+      if (!writing && kbo->written_by_dev)
+         continue;
+
+      struct dma_buf_export_sync_file ex = {
+         .flags = writing ? DMA_BUF_SYNC_WRITE : DMA_BUF_SYNC_READ,
+         .fd = -1,
+      };
+      if (ioctl(kbo->dmabuf_fd, DMA_BUF_IOCTL_EXPORT_SYNC_FILE, &ex) ||
+          ex.fd < 0)
+         continue;
+
+      struct pollfd p = {.fd = ex.fd, .events = POLLIN};
+      if (poll(&p, 1, 0) > 0) {
+         close(ex.fd);
+         continue;
+      }
+
+      if (merged < 0) {
+         merged = ex.fd;
+      } else {
+         struct sync_merge_data sm = {
+            .fd2 = ex.fd,
+            .fence = -1,
+         };
+         memcpy(sm.name, "panvk", 6);
+         if (ioctl(merged, SYNC_IOC_MERGE, &sm) == 0 && sm.fence >= 0) {
+            close(merged);
+            close(ex.fd);
+            merged = sm.fence;
+         } else {
+            int ret;
+            do {
+               ret = poll(&p, 1, 1000);
+            } while (ret < 0 && (errno == EINTR || errno == EAGAIN));
+            close(ex.fd);
+         }
+      }
+   }
+   mtx_unlock(&kdev->dmabuf_lock);
+   return merged;
+}
+
+void
+kbase_kmod_dmabuf_import_signal_fence(struct pan_kmod_dev *dev, int sync_fd,
+                                      struct pan_kmod_bo *const *written_bos,
+                                      unsigned nr_written, bool write_all)
+{
+   struct kbase_kmod_dev *kdev = to_kbase_dev(dev);
+
+   if (sync_fd < 0)
+      return;
+
+   mtx_lock(&kdev->dmabuf_lock);
+   list_for_each_entry(struct kbase_kmod_bo, kbo, &kdev->dmabuf_list,
+                       dmabuf_node) {
+      if (kbo->dmabuf_fd < 0)
+         continue;
+
+      bool writing = write_all || bo_in_list(&kbo->base, written_bos, nr_written);
+      if (writing)
+         kbo->written_by_dev = true;
+      else if (kbo->written_by_dev)
+         continue;
+
+      struct dma_buf_import_sync_file imp = {
+         .flags = writing ? DMA_BUF_SYNC_WRITE : DMA_BUF_SYNC_READ,
+         .fd = sync_fd,
+      };
+      ioctl(kbo->dmabuf_fd, DMA_BUF_IOCTL_IMPORT_SYNC_FILE, &imp);
+   }
+   mtx_unlock(&kdev->dmabuf_lock);
+}
