+/* An idle image whose buffer the screen has let go of. The search starts after the last one
+ * taken: the image shown last is held until the next one replaces it. */
+static bool
+wsi_win32_find_scanout_image(struct wsi_win32_swapchain *chain,
+                             uint32_t *out_image_index)
+{
+   const struct wsi_device *wsi = chain->wsi->wsi;
+   for (uint32_t n = 0; n < chain->base.image_count; n++) {
