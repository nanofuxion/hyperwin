+   if (!fg || (fg != wnd && fg != GetAncestor(wnd, GA_ROOT)))
+      return false;
+   MONITORINFO mi = {};
+   mi.cbSize = sizeof(mi);
+   RECT rc;
+   POINT tl = { 0, 0 };
+   if (!GetMonitorInfo(MonitorFromWindow(wnd, MONITOR_DEFAULTTONEAREST), &mi) ||
+       !GetClientRect(wnd, &rc) || !ClientToScreen(wnd, &tl))
+      return false;
+   return tl.x <= mi.rcMonitor.left && tl.y <= mi.rcMonitor.top &&
+          tl.x + rc.right >= mi.rcMonitor.right && tl.y + rc.bottom >= mi.rcMonitor.bottom;
