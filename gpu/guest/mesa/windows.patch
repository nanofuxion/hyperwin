+HwgpuConnection* HwgpuConnection::get() {
+    static std::once_flag once;
+    static HwgpuConnection* conn = nullptr;
+    std::call_once(once, [] {
+        // The WDDM adapter first (include/hw_wddm.h): D3DKMTEscape maps the channel. Without it, the
+        // legacy \\.\HwGpu device (hwgpu.sys).
+        HANDLE dev = INVALID_HANDLE_VALUE;
+        hwgpu_open_out out = {};
+        auto* w = new hww();
+        struct hww_open wo;
+        if (hww_open(w) && hww_open_channel(w, &wo) >= 0) {
+            out.chan = wo.chan;
+            out.slot = wo.slot;
+            out.generation = wo.generation;
+        } else {
+            delete w;
+            w = nullptr;
+            dev = CreateFileW(HWGPU_USER_PATH, GENERIC_READ | GENERIC_WRITE, 0, nullptr,
+                              OPEN_EXISTING, 0, nullptr);
+            if (dev == INVALID_HANDLE_VALUE) {
+                mesa_loge("hwgpu: no HyperWin GPU adapter and no \\\\.\\HwGpu (error %lu)", GetLastError());
+                return;
+            }
+            DWORD got = 0;
+            if (!DeviceIoControl(dev, IOCTL_HWGPU_OPEN, nullptr, 0, &out, sizeof(out), &got, nullptr) ||
+                got != sizeof(out)) {
+                mesa_loge("hwgpu: no GPU channel (error %lu)", GetLastError());
+                CloseHandle(dev);
+                return;
+            }
+        }
+        void* chan = reinterpret_cast<void*>(uintptr_t(out.chan));
+        // The phone answers within one pass of its loop; give it a few seconds.
+        for (int i = 0; i < 3000 && !hwgpu_alive(hwgpu_chan_ctl(chan), out.generation); i++) Sleep(1);
+        auto* c = new HwgpuConnection(dev, chan, out.slot, out.generation);
+        c->setAdapter(w);
+        if (!hwgpu_alive(hwgpu_chan_ctl(chan), out.generation) || !c->hello()) {
+            mesa_loge("hwgpu: the phone did not answer on channel %u", out.slot);
+            if (dev != INVALID_HANDLE_VALUE) CloseHandle(dev);
+            delete c;
+            return;
+        }
+        mesa_logi("hwgpu: channel %u", out.slot);
+        conn = c;
+    });
+    return conn;
+}
+
+// The one place bytes move. The WDDM variant replaces this with a call into its kernel driver.
+std::vector<uint8_t> HwgpuConnection::callLocked(const void* req, size_t len, const void* tail,
+                                                 size_t tail_len) {
+    if (mBroken) return {};
+    uint32_t n = uint32_t(len + tail_len);
+    std::vector<uint8_t> r;
+    if (hwgpu_write_all(mChan, mGeneration, 1, &n, sizeof(n)) &&
+        hwgpu_write_all(mChan, mGeneration, 1, req, len) &&
+        (!tail_len || hwgpu_write_all(mChan, mGeneration, 1, tail, tail_len)) &&
+        hwgpu_read_all(mChan, mGeneration, 1, &n, sizeof(n)) && n >= sizeof(vgpu_hdr) &&
+        n <= (256u << 20)) {
+        r.resize(n);
+        if (hwgpu_read_all(mChan, mGeneration, 1, r.data(), n)) return r;
+    }
+    // Requests and replies share one stream; after a failure they can no longer be paired.
+    mesa_loge("hwgpu: channel %u lost", mSlot);
+    mBroken = true;
+    return {};
+}
+
+// HWGPU_STATS=<file> in the environment: every 2 s, how the round trips to the phone were spent,
+// appended to that file.
+HwgpuStats g_hwgpu_stats;
+
+static uint64_t qpc_us() {
+    static LARGE_INTEGER f;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    LARGE_INTEGER n;
+    QueryPerformanceCounter(&n);
+    return uint64_t(n.QuadPart) * 1000000ull / uint64_t(f.QuadPart);
+}
+
+void hwgpu_stat(uint32_t type, uint64_t us) {
+    static const char* path = getenv("HWGPU_STATS");
+    if (!path) return;
+    auto& s = g_hwgpu_stats;
+    std::lock_guard<std::mutex> l(s.lock);
+    s.calls++;
+    s.us += us;
+    if (type == VGPU_CMD_TRANSFER_TO_HOST_3D) s.to_host++, s.to_host_us += us;
+    if (type == VGPU_CMD_TRANSFER_FROM_HOST_3D) s.from_host++, s.from_host_us += us;
+    if (type == SGPU_RESP_AGAIN) s.again++, s.again_us += us;
+    uint64_t now = qpc_us();
+    if (!s.since) s.since = now;
+    if (now - s.since >= 2000000) {
+        if (FILE* f = fopen(path, "a")) {
+            fprintf(f, "%llu ms: %llu calls %llu us | to_host %llu %llu us | from_host %llu %llu us | again %llu, waited %llu us\n",
+                    (unsigned long long)((now - s.since) / 1000), (unsigned long long)s.calls, (unsigned long long)s.us,
+                    (unsigned long long)s.to_host, (unsigned long long)s.to_host_us, (unsigned long long)s.from_host,
+                    (unsigned long long)s.from_host_us, (unsigned long long)s.again, (unsigned long long)s.again_us);
+            fclose(f);
+        }
+        s.calls = s.us = s.to_host = s.to_host_us = s.from_host = s.from_host_us = s.again = s.again_us = 0;
+        s.since = now;
+    }
+}
+
+uint64_t hwgpu_now_us() { return qpc_us(); }
+
+std::vector<uint8_t> HwgpuConnection::call(const void* req, size_t len, const void* tail,
+                                           size_t tail_len) {
+    std::lock_guard<std::recursive_mutex> l(mLock);
+    uint64_t t0 = qpc_us();
+    auto r = callLocked(req, len, tail, tail_len);
+    hwgpu_stat(reinterpret_cast<const vgpu_hdr*>(req)->type, qpc_us() - t0);
+    return r;
+}
+
+int HwgpuConnection::post(const void* req, size_t len, const void* tail, size_t tail_len) {
+    std::lock_guard<std::recursive_mutex> l(mLock);
+    if (mBroken) return -EIO;
+    uint64_t t0 = qpc_us();
+    uint32_t n = uint32_t(len + tail_len);
+    bool ok = hwgpu_write_all(mChan, mGeneration, 1, &n, sizeof(n)) &&
+              hwgpu_write_all(mChan, mGeneration, 1, req, len) &&
+              (!tail_len || hwgpu_write_all(mChan, mGeneration, 1, tail, tail_len));
+    hwgpu_stat(reinterpret_cast<const vgpu_hdr*>(req)->type, qpc_us() - t0);
+    if (ok) return 0;
+    mesa_loge("hwgpu: channel %u lost", mSlot);
+    mBroken = true;
+    return -EIO;
+}
+
+int HwgpuConnection::simple(const void* req, size_t len, const void* tail, size_t tail_len) {
+    auto r = call(req, len, tail, tail_len);
+    if (r.empty()) return -EIO;
+    uint32_t type = reinterpret_cast<const vgpu_hdr*>(r.data())->type;
+    if (type != VGPU_RESP_OK_NODATA) {
+        mesa_loge("hwgpu: command 0x%x failed with 0x%x",
+                  reinterpret_cast<const vgpu_hdr*>(req)->type, type);
+        return -EIO;
+    }
+    return 0;
+}
+
+uint32_t HwgpuConnection::context(enum VirtGpuCapset capset) {
+    std::lock_guard<std::recursive_mutex> l(mLock);
+    if (mContext) return mContext;
+    vgpu_ctx_create cc = {};
+    cc.hdr.type = VGPU_CMD_CTX_CREATE;
+    cc.hdr.ctx_id = HWGPU_CTX(mSlot);
+    cc.context_init = uint32_t(capset == kCapsetNone ? kCapsetGfxStreamVulkan : capset) &
+                      VGPU_CONTEXT_INIT_CAPSET_ID_MASK;
+    char path[MAX_PATH] = {};
+    GetModuleFileNameA(nullptr, path, sizeof(path));
+    const char* name = strrchr(path, '\\') ? strrchr(path, '\\') + 1 : path;
+    cc.nlen = uint32_t(std::min(strlen(name), sizeof(cc.debug_name) - 1));
+    memcpy(cc.debug_name, name, cc.nlen);
+    if (simple(&cc, sizeof(cc)) == 0) mContext = HWGPU_CTX(mSlot);
+    return mContext;
+}
+
+uint32_t HwgpuConnection::newResourceId() {
+    std::lock_guard<std::recursive_mutex> l(mLock);
+    return HWGPU_RES_BASE(mSlot) + mNextResource++;
+}
+
+bool HwgpuConnection::hello() {
+    sgpu_hello h = {};
+    h.hdr.type = SGPU_CMD_HELLO;
+    h.version = SGPU_VERSION;
+    auto r = call(&h, sizeof(h));
+    if (r.size() < sizeof(sgpu_hello_resp) ||
+        reinterpret_cast<sgpu_hello_resp*>(r.data())->hdr.type != SGPU_RESP_OK_HELLO)
+        return false;
+    mScanout = reinterpret_cast<sgpu_hello_resp*>(r.data())->hdr.flags & SGPU_HELLO_SCANOUT;
+    uint32_t count = reinterpret_cast<sgpu_hello_resp*>(r.data())->num_capsets;
+    for (uint32_t i = 0; i < count; i++) {
+        vgpu_get_capset_info q = {};
+        q.hdr.type = VGPU_CMD_GET_CAPSET_INFO;
+        q.capset_index = i;
+        auto ri = call(&q, sizeof(q));
+        if (ri.size() < sizeof(vgpu_resp_capset_info)) return false;
+        auto info = *reinterpret_cast<vgpu_resp_capset_info*>(ri.data());
+        if (info.hdr.type != VGPU_RESP_OK_CAPSET_INFO) continue;
+        vgpu_get_capset g = {};
+        g.hdr.type = VGPU_CMD_GET_CAPSET;
+        g.capset_id = info.capset_id;
+        g.capset_version = info.capset_max_version;
+        auto rc = call(&g, sizeof(g));
+        if (rc.size() < sizeof(vgpu_hdr) ||
+            reinterpret_cast<vgpu_hdr*>(rc.data())->type != VGPU_RESP_OK_CAPSET)
+            continue;
+        mCapsets[info.capset_id].assign(rc.begin() + sizeof(vgpu_hdr), rc.end());
+    }
+    return true;
+}
+
+void* HwgpuConnection::mapHeap(uint64_t offset, uint64_t size) {
+    hwgpu_map_in in = {offset, size};
+    hwgpu_map_out out = {};
+    DWORD got = 0;
+    if (mAdapter) {
+        uint64_t user = 0;
+        if (hww_map(mAdapter, mSlot, in.offset, in.size, &user) < 0) user = 0;
+        out.user = user;
+        got = user ? sizeof(out) : 0;
+    } else if (!DeviceIoControl(mDev, IOCTL_HWGPU_MAP, &in, sizeof(in), &out, sizeof(out), &got, nullptr) ||
+        got != sizeof(out)) {
+        mesa_loge("hwgpu: heap map at 0x%llx failed (error %lu)", (unsigned long long)offset, GetLastError());
+        return nullptr;
+    }
+    return reinterpret_cast<void*>(uintptr_t(out.user));
+}
+
+void HwgpuConnection::unmapHeap(void* p) {
+    hwgpu_map_out in = {uint64_t(uintptr_t(p))};
+    DWORD got = 0;
+    if (mAdapter) {
+        hww_escape e = {};
+        e.op = HWW_ESC_UNMAP;
+        e.u.map.slot = mSlot;
+        e.u.map.user = in.user;
+        hww_call(mAdapter, &e);
+    } else {
+        DeviceIoControl(mDev, IOCTL_HWGPU_UNMAP, &in, sizeof(in), nullptr, 0, &got, nullptr);
+    }
+}
