+
+// At least us microseconds: short waits yield the core while watching the clock, longer ones use
+// hwgpu_pause's high-resolution timer.
+static void wait_us(unsigned us) {
+    if (us >= 1000) return hwgpu_pause(us);
+    LARGE_INTEGER f, start, now;
+    QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&start);
+    do {
+        SwitchToThread();
+        QueryPerformanceCounter(&now);
+    } while (uint64_t(now.QuadPart - start.QuadPart) * 1000000ull < uint64_t(us) * uint64_t(f.QuadPart));
