+static VkResult
+wsi_win32_surface_create_swapchain(
+   VkIcdSurfaceBase *icd_surface,
+   VkDevice device,
+   struct wsi_device *wsi_device,
+   const VkSwapchainCreateInfoKHR *create_info,
+   const VkAllocationCallbacks *allocator,
+   struct wsi_swapchain **swapchain_out)
+{
+   struct wsi_win32 *wsi =
+      (struct wsi_win32 *) wsi_device->wsi[VK_ICD_WSI_PLATFORM_WIN32];
+   HWND wnd = ((VkIcdSurfaceWin32 *)icd_surface)->hwnd;
+
+   bool able = wsi_win32_scanout_possible(wsi, device, create_info);
+   bool scanout = able && wsi_win32_scanout_wanted(wnd);
+   VkResult result =
+      wsi_win32_surface_create_swapchain_mode(icd_surface, device, wsi_device, create_info,
+                                              allocator, scanout, able, swapchain_out);
+   if (result == VK_SUCCESS || !scanout)
+      return result;
+
+   /* The phone could not make the buffers (or import them as this format): GDI it is. */
+   mesa_logw("wsi: hwgpu scanout failed (%d), presenting by GDI", result);
+   return wsi_win32_surface_create_swapchain_mode(icd_surface, device, wsi_device, create_info,
+                                                  allocator, false, false, swapchain_out);
+}
