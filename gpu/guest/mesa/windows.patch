+int WindowsVirtGpuResource::transfer(bool toHost, uint32_t x, uint32_t y, uint32_t w, uint32_t h) {
+    uint8_t* p = local();
+    if (!p) return -ENOMEM;
+    // Buffers (and pipes) move bytes [x, x + w). Images move whole rows.
+    uint64_t off = x, len = w;
+    if (h > 1 || y) {
+        off = uint64_t(y) * mStride;
+        len = uint64_t(h) * mStride;
+    }
+    if (off > mSize || len > mSize - off) return -EINVAL;
+
+    auto* c = HwgpuConnection::get();
+    struct {
+        vgpu_transfer_3d t;
+        uint32_t len;
+    } __attribute__((packed)) req = {};
+    req.t.hdr.type = toHost ? VGPU_CMD_TRANSFER_TO_HOST_3D : VGPU_CMD_TRANSFER_FROM_HOST_3D;
+    req.t.hdr.ctx_id = mCtxId;
+    req.t.box = {x, y, 0, w, h, 1};
+    req.t.offset = off;
+    req.t.resource_id = mResourceHandle;
+    req.t.stride = mStride;
+    req.len = uint32_t(len);
+    if (toHost) {
+        c->pushIfNoted();
+        return c->simple(&req, sizeof(req), p + off, size_t(len));
+    }
+    // A pipe with nothing to read yet answers AGAIN. Ask again, backing off, without holding
+    // the connection, so other threads keep streaming while this one waits on the host.
+    std::vector<uint8_t> r;
+    for (unsigned backoff = 50;; backoff = std::min(backoff * 2, 2000u)) {
+        r = c->call(&req, sizeof(req));
+        if (r.size() != sizeof(vgpu_hdr) ||
+            reinterpret_cast<vgpu_hdr*>(r.data())->type != SGPU_RESP_AGAIN)
+            break;
+        hwgpu_pause(backoff);
+    }
+    if (r.size() != sizeof(sgpu_resp_data) + len ||
+        reinterpret_cast<sgpu_resp_data*>(r.data())->hdr.type != SGPU_RESP_OK_DATA)
+        return -EIO;
+    memcpy(p + off, r.data() + sizeof(sgpu_resp_data), size_t(len));
+    return 0;
 }
 
