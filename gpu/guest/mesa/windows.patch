+// Windows VirtGpu backend for HyperWin: SweetCider's sgpu requests (virtio-gpu control commands,
+// sgpu_proto.h) carried through a byte ring in RAM shared with the Android host (hwgpu_ring.h).
+// hwgpu.sys maps this process's channel into it (hwgpu_ioctl.h); after that no system call sits
+// between the encoder and the phone. Mapped blobs are guest copies kept in step with the host's:
+// guest changes go out before a queue submit, host changes come back after a wait for the GPU.
+
 #pragma once
 
+#include <atomic>
+#include <cstddef>
+#include <map>
+#include <mutex>
+#include <vector>
+
 #include "VirtGpu.h"
 
+class HwgpuConnection {
+   public:
+    // The process-wide connection, opened on first use.
+    static HwgpuConnection* get();
+
+    // Sends one request and returns its reply (starting with vgpu_hdr), or an empty vector when
+    // the connection failed.
+    std::vector<uint8_t> call(const void* req, size_t len, const void* tail = nullptr,
+                              size_t tail_len = 0);
+    // call() for commands answered with OK_NODATA. Returns 0 or -EIO.
+    int simple(const void* req, size_t len, const void* tail = nullptr, size_t tail_len = 0);
+
+    // One host context per process, id HWGPU_CTX(slot). Created on first use, with Vulkan when
+    // the first device names no capset.
+    uint32_t context(enum VirtGpuCapset capset);
+    uint32_t newResourceId();
+
+    const std::map<uint32_t, std::vector<uint8_t>>& capsets() const { return mCapsets; }
+
+    void addMirror(uint32_t resourceId, uint8_t* local, size_t size);
+    void removeMirror(uint32_t resourceId);
+    // Sends guest changes to every mirror; with pull, also applies the host's changes.
+    void sync(bool pull);
+    // The host only reads mapped memory when it runs a queue submit, so guest changes go out with
+    // the first bytes streamed after one was started, not with every write.
+    void notePush() { mPush.store(true); }
+    void pushIfNoted();
+
+   private:
+    // The \\.\HwGpu handle stays open for the life of the process; closing it frees the channel.
+    HwgpuConnection(void* chan, uint32_t slot, uint32_t generation)
+        : mChan(chan), mSlot(slot), mGeneration(generation) {}
+    bool hello();
+    std::vector<uint8_t> callLocked(const void* req, size_t len, const void* tail,
+                                    size_t tail_len);
+
+    struct Mirror {
+        uint8_t* local;
+        std::vector<uint8_t> last;  // contents at the last sync
+    };
+
+    void* mChan;
+    uint32_t mSlot;
+    uint32_t mGeneration;
+    bool mBroken = false;
+    std::atomic<bool> mPush{false};
+    std::recursive_mutex mLock;
+    uint32_t mContext = 0;
+    uint32_t mNextResource = 1;
+    std::map<uint32_t, std::vector<uint8_t>> mCapsets;
+    std::map<uint32_t, Mirror> mMirrors;
+};
