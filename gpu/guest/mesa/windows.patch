+
+void HwgpuConnection::sync(bool pull) {
+    std::lock_guard<std::recursive_mutex> l(mLock);
+    if (mMirrors.empty()) return;
+
+    vgpu_hdr h = {};
+    h.type = SGPU_CMD_SYNC;
+    // Guest changes since the last sync, as runs of changed pages, at most SGPU_SYNC_CHUNK
+    // bytes per message.
+    std::vector<uint8_t> body;
+    auto push = [&]() {
+        h.flags = 0;
+        auto r = callLocked(&h, sizeof(h), body.data(), body.size());
+        body.clear();
+        return r.size() >= sizeof(vgpu_hdr) &&
+               reinterpret_cast<vgpu_hdr*>(r.data())->type == SGPU_RESP_SYNC;
+    };
+    for (auto& [res, m] : mMirrors) {
+        const size_t size = m.last.size();
+        size_t off = 0;
+        while (off < size) {
+            if (body.size() >= SGPU_SYNC_CHUNK && !push()) {
+                mesa_loge("hwgpu: sync failed");
+                return;
+            }
+            size_t n = std::min<size_t>(SGPU_SYNC_PAGE, size - off);
+            if (!memcmp(m.local + off, m.last.data() + off, n)) {
+                off += n;
+                continue;
+            }
+            size_t start = off;
+            while (off < size && off - start < SGPU_SYNC_CHUNK) {
+                n = std::min<size_t>(SGPU_SYNC_PAGE, size - off);
+                if (!memcmp(m.local + off, m.last.data() + off, n)) break;
+                off += n;
+            }
+            // Copy first, then send the copy, so what the host gets is what we remember.
+            memcpy(m.last.data() + start, m.local + start, off - start);
+            sgpu_sync_entry e = {res, uint32_t(off - start), start};
+            const auto* eb = reinterpret_cast<const uint8_t*>(&e);
+            body.insert(body.end(), eb, eb + sizeof(e));
+            body.insert(body.end(), m.last.data() + start, m.last.data() + off);
+        }
+    }
+    if (!pull) {
+        if (!body.empty() && !push()) mesa_loge("hwgpu: sync failed");
+        return;
+    }
+
+    // The last guest changes go with the first pull. The host answers with its changes since
+    // the last sync, SGPU_SYNC_CHUNK at a time.
+    for (bool more = true; more;) {
+        h.flags = SGPU_SYNC_PULL;
+        auto r = callLocked(&h, sizeof(h), body.data(), body.size());
+        body.clear();
+        if (r.size() < sizeof(vgpu_hdr) ||
+            reinterpret_cast<vgpu_hdr*>(r.data())->type != SGPU_RESP_SYNC) {
+            mesa_loge("hwgpu: sync failed");
+            return;
+        }
+        more = reinterpret_cast<vgpu_hdr*>(r.data())->flags & SGPU_SYNC_MORE;
+        size_t at = sizeof(vgpu_hdr);
+        while (at + sizeof(sgpu_sync_entry) <= r.size()) {
+            sgpu_sync_entry e;
+            memcpy(&e, r.data() + at, sizeof(e));
+            at += sizeof(e);
+            if (at + e.len > r.size()) break;
+            auto it = mMirrors.find(e.resource_id);
+            if (it != mMirrors.end() && e.offset + e.len <= it->second.last.size()) {
+                memcpy(it->second.local + e.offset, r.data() + at, e.len);
+                memcpy(it->second.last.data() + e.offset, r.data() + at, e.len);
+            }
+            at += e.len;
+        }
+    }
+}
+
+void HwgpuConnection::pushIfNoted() {
+    // Under the lock, so no other thread's bytes pass between the check and the push.
+    std::lock_guard<std::recursive_mutex> l(mLock);
+    if (mPush.exchange(false)) sync(false);
+}
+
+void virtGpuGuestMemoryWillBeRead() {
+    if (auto* c = HwgpuConnection::get()) c->notePush();
+}
+
+void virtGpuHostMemoryWasWritten() {
+    if (auto* c = HwgpuConnection::get()) c->sync(true);
+}
 
