; HyperWin GPU: a render-only WDDM adapter (wddm/README.md). One root device, ROOT\HwGpuAdapter. Like Windows'
; own Basic Render Driver it is in the System class: the Display class expects screens.
; The Vulkan driver is registered on the adapter (VulkanDriverName) instead of in Khronos' global key.
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %Mfg%
CatalogFile = hwgpuw.cat
DriverVer   = 11/18/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
Hw.Miniport = 13
Hw.Vulkan   = 13
Hw.D3D      = 13
Hw.GL       = 13

[SourceDisksNames]
1 = %Disk%,,,

[SourceDisksFiles]
hwgpuw.sys        = 1
vulkan_hwgpu.dll  = 1
vulkan_hwgpu.json = 1
vulkan_hwgpu_x86.dll  = 1
vulkan_hwgpu_x86.json = 1
hwd3d_umd.dll     = 1
hwd3d_umd_x86.dll = 1
hwgl.dll          = 1
hwgl_x86.dll      = 1

[Manufacturer]
%Mfg% = Hw, NTarm64

[Hw.NTarm64]
%Desc% = Install, Root\HwGpuAdapter

[Install.NT]
FeatureScore = FB
CopyFiles = Hw.Miniport, Hw.Vulkan, Hw.D3D, Hw.GL
AddReg    = Install.AddReg

[Hw.Miniport]
hwgpuw.sys,,,0x100

[Hw.Vulkan]
vulkan_hwgpu.dll,,,0x100
vulkan_hwgpu.json,,,0x100
vulkan_hwgpu_x86.dll,,,0x100
vulkan_hwgpu_x86.json,,,0x100

[Hw.D3D]
hwd3d_umd.dll,,,0x100
hwd3d_umd_x86.dll,,,0x100

; OpenGL: Mesa's Zink as an ICD (libgallium_wgl.dll, ARM64X, and its i686 build; opengl/README.md). Windows asks
; the screen's adapter, and the HyperWin screen (an indirect display) passes the question to its render adapter.
[Hw.GL]
hwgl.dll,,,0x100
hwgl_x86.dll,,,0x100

[Install.NT.Services]
AddService = hwgpuw, 0x00000002, Hw.Service

[Hw.Service]
ServiceType    = 1
StartType      = 3
ErrorControl   = 0
LoadOrderGroup = Video
ServiceBinary  = %13%\hwgpuw.sys

[Install.AddReg]
HKR,,VulkanDriverName,0,"%13%\vulkan_hwgpu.json"
HKR,,VulkanDriverNameWow,0,"%13%\vulkan_hwgpu_x86.json"
; The Direct3D 10/11 driver (gpu/guest/hwd3d/umd.cpp, wddm/README.md phase 4). The 32-bit one is the same code built for i686.
; One name per Direct3D version, in order: 9, 10, 11, 12. Full paths: the kernel opens them to read their version.
HKR,,UserModeDriverName,0x00010000,"%13%\hwd3d_umd.dll","%13%\hwd3d_umd.dll","%13%\hwd3d_umd.dll","%13%\hwd3d_umd.dll"
HKR,,UserModeDriverNameWow,0x00010000,"%13%\hwd3d_umd_x86.dll","%13%\hwd3d_umd_x86.dll","%13%\hwd3d_umd_x86.dll","%13%\hwd3d_umd_x86.dll"
HKR,,InstalledDisplayDrivers,0x00010000,"hwd3d_umd"
HKR,,OpenGLDriverName,0,"%13%\hwgl.dll"
HKR,,OpenGLVersion,0x00010001,1
HKR,,OpenGLFlags,0x00010001,1
HKR,,OpenGLDriverNameWow,0,"%13%\hwgl_x86.dll"
HKR,,OpenGLVersionWow,0x00010001,1
HKR,,OpenGLFlagsWow,0x00010001,1

[Strings]
Mfg  = "HyperWin"
Disk = "HyperWin GPU"
Desc = "HyperWin GPU"
