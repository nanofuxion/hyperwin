<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.MANAGE_VIRTUAL_MACHINE" />
    <!-- Phone storage as Windows drives (FileShare.kt). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.USE_CUSTOM_VIRTUAL_MACHINE" />
    <!-- Windows' microphone, and the foreground service while Windows runs (GuestAudio.kt, WindowsService.kt). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Rumble on controllers and on the phone (GamepadInput.kt). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Phone motion at 250 Hz for player 1's DualShock 4 (GamepadInput.kt); above 200 Hz needs this. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- Updates from GitHub Releases, confirmed on Android's own install screen (Updater.kt). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-feature android:name="android.software.virtualization_framework" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <queries><package android:name="moe.shizuku.privileged.api" /></queries>

    <application
        android:name=".HyperWinApp"
        android:label="HyperWin"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.HyperWin"
        android:appCategory="game">
        <!-- game-mode/README.md: the Game Dashboard's Performance and Battery modes. -->
        <meta-data android:name="android.game_mode_config" android:resource="@xml/game_mode_config" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:configChanges="uiMode|keyboard|keyboardHidden|navigation|screenLayout|screenSize|smallestScreenSize|orientation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The GPU renderer and its Vulkan driver, apart from the VM's owner (HwGpu.kt). -->
        <service android:name=".GpuService" android:process=":gpu" android:exported="false" />
        <!-- Direct3D programs other than the desktop's, so one that crashes leaves the desktop up. -->
        <service android:name=".GameGpuService" android:process=":games" android:exported="false" />
        <service android:name=".WindowsService" android:exported="false"
            android:foregroundServiceType="mediaPlayback|microphone" />
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
